---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const services = [
  {
    title: 'Fractional CTO & engineering leadership',
    description:
      'Technical strategy, architecture, engineering management, hiring, product planning, and security. I help founders turn business goals into an engineering plan.',
    details: [
      'Set technical direction and own the roadmap conversation with Product and GTM',
      'Build the org: define roles, hire, structure teams, and add engineering managers as headcount grows',
      'Own budget, vendor, and build-vs-buy decisions along with architecture',
      'Represent engineering in fundraising and board conversations: diligence questions, technical vision, and credibility with investors',
    ],
  },
  {
    title: 'Security & enterprise readiness',
    description:
      'SOC 2, ISO 27001, security processes, enterprise requirements, and technical due diligence. I clear the technical blockers that show up when you start selling to larger companies.',
    details: [
      'Took ManageXR through SOC 2 Type II and ISO 27001 certification and annual re-certification',
      'Build the audit and IT operations process that keeps compliance routine year to year',
      'Join enterprise sales cycles as the technical and security counterpart when a deal needs one',
      'Handle technical due diligence requests without pulling the rest of the team off their work',
    ],
  },
  {
    title: 'Engineering team development',
    description:
      'Hiring, engineering practices, technical leadership, team structure, and developer tooling for a growing team.',
    details: [
      "Built the hiring and interviewing process that grew ManageXR's team from 3 to 15 engineers",
      'Set code review and engineering standards that keep quality high without slowing down shipping',
      'Coach engineers into tech leads and managers',
      'Give a second opinion on hard architecture decisions your team is stuck on',
      'Roll out modern tooling across a team, including agentic development workflows',
    ],
  },
];
---

<Layout
  title="Consulting · John Morgan"
  description="Fractional CTO and engineering advisory work with founders and small engineering teams."
>
  <SiteHeader active="consulting" />

  <main>
    <section>
      <span class="eyebrow">Consulting</span>
      <h1>Fractional CTO &amp; engineering advisory</h1>
      <p class="lead">
        I work with founders and small engineering teams on the problems that show up as a company
        grows: architecture, hiring, engineering management, security, technical strategy,
        enterprise customers, and deciding what to build.
      </p>
    </section>

    <section>
      <h2>Background</h2>
      <p>
        I'm a software engineer in Chicago, currently building something new at <a
          href="https://faebriel.com"
          target="_blank"
          rel="noopener">Faebriel</a
        >.
      </p>
      <p>
        Before that I ran engineering at ManageXR, reporting to the CEO. The team grew from 3 to 15
        people. I owned technical deliverables, hiring, management, budget, architecture, and
        security, and worked with Product and GTM on what we built and why. Before ManageXR I spent four years at Google on Search and Maps, working on
        large-scale backend systems, machine learning, and search ranking.
      </p>
      <p>
        I've always done both leadership and hands-on technical work. I set strategy and build the
        org around it, and I still get into the code when a hard problem needs solving.
      </p>
    </section>

    <section>
      <h2>Who it's for</h2>
      <p>
        Founder-led software companies with small engineering teams that have outgrown informal
        technical leadership but aren't ready to hire a full-time CTO or VP of Engineering. I do my
        best work where the problems are still messy and the decisions matter.
      </p>
    </section>

    <section>
      <h2>Services</h2>
      {
        services.map((service) => (
          <div class="entry">
            <div class="entry-head">
              <h3>{service.title}</h3>
            </div>
            <p>{service.description}</p>
            <ul>
              {service.details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Get in touch</h2>
      <p>If this sounds like where your team is, send me an email.</p>
      <a class="cta" href="mailto:john5morgan29@gmail.com">Email me &rarr;</a>
    </section>
  </main>

  <SiteFooter />
</Layout>
