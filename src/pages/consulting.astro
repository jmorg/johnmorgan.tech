---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const services = [
  {
    title: 'Fractional CTO & Engineering Leadership',
    description:
      'Technical strategy, architecture, engineering management, hiring, product planning, security, and helping founders translate business goals into an engineering plan.',
    details: [
      'Set technical direction and own the roadmap conversation with Product and GTM, not just engineering',
      'Build the org: define roles, hire, structure teams, and put engineering management in place as headcount grows',
      'Own budget, vendor, and build-vs-buy decisions alongside architecture',
      'Represent the technical side in fundraising and board conversations — diligence questions, technical vision, credibility with investors',
    ],
  },
  {
    title: 'Security & Enterprise Readiness',
    description:
      'SOC 2, ISO 27001, security processes, enterprise requirements, technical due diligence, and removing the technical blockers that appear when you start selling to larger companies.',
    details: [
      'Took ManageXR through SOC 2 Type II and ISO 27001 certification, then annual re-certification',
      'Build the ongoing audit and IT operations process so compliance is durable, not a yearly fire drill',
      'Sit in on enterprise sales cycles as the technical/security counterpart when deals need it',
      'Handle technical due diligence requests without derailing the rest of the team',
    ],
  },
  {
    title: 'Engineering Team Development',
    description:
      'Hiring and interviewing, engineering practices, technical leadership, team structure, developer tooling, and helping a growing team operate effectively.',
    details: [
      'Built a hiring and interviewing process that took a team from 3 to 14 engineers',
      'Set code review, PR, and engineering standards norms that keep quality up without slowing shipping down',
      'Coach and develop engineers into tech leads and managers, not just fill seats',
      'Weigh in as a second opinion on hard, ambiguous architecture decisions your team is stuck on',
      'Introduce and roll out modern tooling, including agentic development workflows, across a team',
    ],
  },
];
---

<Layout
  title="Consulting — John Morgan"
  description="Fractional CTO and engineering advisory work with founders and small engineering teams."
>
  <SiteHeader active="consulting" />

  <main>
    <a class="back-link" href="/">&larr; back home</a>
    <span class="eyebrow">Consulting</span>
    <h1 class="page-intro">Fractional CTO &amp; engineering advisory</h1>
    <p>
      "Good software should feel like magic." That's a bet on the right problems and the right
      craft.
    </p>

    <section class="detail-block">
      <h3>Background</h3>
      <p>
        I'm John Morgan, a software engineer currently living in Chicago, working on building
        something new at <a href="https://faebriel.com" target="_blank" rel="noopener"
          >Faebriel</a
        >.
      </p>
      <p>
        Previously, I ran the engineering team at ManageXR where I reported directly to the CEO
        and helped grow the engineering organization from 3 to 14 people during a period when the
        business grew 30x. I owned all technical deliverables, hiring, management, budget,
        architecture, and security, while working closely with Product and GTM on what we built
        and why.
      </p>
      <p>
        Before that, I spent four years at Google working on Search and Maps, including
        large-scale backend systems, machine learning, and search ranking.
      </p>
      <p>
        My work has always spanned engineering leadership and hands-on technical work: setting
        strategy and building the organization around it, but also getting into the code when
        something difficult needs to be solved.
      </p>
      <p>
        In addition to what I'm working on at Faebriel, I work with founders and small engineering
        teams on the problems that start appearing as a company grows: architecture, hiring,
        engineering management, security, technical strategy, enterprise customers, and figuring
        out what should actually get built.
      </p>
      <p>
        I'm particularly happy working with small teams where the problems are still messy, the
        decisions matter, and the person setting technical direction isn't afraid to open the
        codebase. I'm particularly useful to founder-led software companies with small engineering
        teams that have started to outgrow informal technical leadership but aren't ready to hire
        a full-time CTO or VP Engineering.
      </p>
    </section>

    <section class="detail-block">
      <h3>Services</h3>
      <p>Here are some ways I can help:</p>
      {
        services.map((service) => (
          <div class="entry">
            <div class="entry-head">
              <span class="entry-title">{service.title}</span>
            </div>
            <p>{service.description}</p>
            <ul>
              {service.details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="detail-block">
      <h3>Get in touch</h3>
      <p>Reach out if this sounds like a fit for where your team is right now.</p>
      <a class="cta" href="mailto:john5morgan29@gmail.com">Email me &rarr;</a>
    </section>
  </main>

  <SiteFooter />
</Layout>
