---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CALENDAR_URL, EMAIL_URL } from '../data/links';

const offers = [
  {
    title: 'Fractional CTO',
    description:
      'Ongoing part-time technical leadership: architecture and roadmap decisions, running the engineering team, hiring, and being the technical voice with your investors and biggest customers.',
  },
  {
    title: 'AI-native engineering audit',
    description:
      'I look at how your team actually builds today (tooling, workflow, code review, testing, deploys) and leave you with a concrete plan to get real leverage from Cursor, Claude Code and agentic workflows. Then I help you roll it out.',
  },
  {
    title: 'Hiring and engineer assessments',
    description:
      'I design your engineering hiring loop and leveling, or run independent, evidence-based assessments of candidates and existing engineers through code review, live working sessions and a written rubric.',
  },
  {
    title: 'Technical due diligence',
    description:
      "For investors and acquirers: a fast, independent read on a company's codebase, architecture, team and technical risk.",
  },
  {
    title: 'SOC 2 readiness and engineering partnership',
    description:
      "When enterprise customers start asking for SOC 2, I partner with your team to get there without slowing product work: gap assessment, building the controls into how engineering already works, and support through the audit. I've taken a company through SOC 2 Type II and ISO 27001 certification and annual re-certification.",
  },
];
---

<Layout
  title="Work with me · John Morgan"
  description="Fractional CTO for founder-led software companies with 2 to 20 engineers: technical leadership, AI-native engineering, hiring, due diligence, and SOC 2 readiness."
>
  <SiteHeader active="consulting" />

  <main>
    <section>
      <span class="eyebrow">Fractional CTO &amp; advisory</span>
      <h1>Work with me</h1>
      <p class="lead">
        I work with founder-led software companies with 2 to 20 engineers that need senior
        technical leadership but aren't ready for a full-time CTO or VP of Engineering.
      </p>
    </section>

    <section>
      <h2>How I can help</h2>
      {
        offers.map((offer) => (
          <div class="entry">
            <div class="entry-head">
              <h3>{offer.title}</h3>
            </div>
            <p>{offer.description}</p>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Case study</h2>
      <div class="entry">
        <div class="entry-head">
          <h3>Building an AI-native engineering org at ManageXR</h3>
        </div>
        {/* TODO: one or two sentences on the starting point */}
        <p>
          <strong>Problem:</strong> [TODO: one or two sentences on the starting point, e.g. a small team facing fast-growing
          enterprise demand with process built for 3 people]
        </p>
        <p>
          <strong>What I did:</strong> Grew the team from 3 to 15 engineers, designed the hiring
          ladder and loop, set engineering standards, and led the shift to AI-first development with Cursor and
          Claude Code, including tech talks and getting the support and business teams onto AI and
          MCP tools.
        </p>
        {/* TODO: optional engineering metric; delete the placeholder if there isn't one */}
        <p>
          <strong>Result:</strong> ARR grew 30x over the period. [TODO: optional engineering metric
          such as deploy frequency, cycle time or time to hire]
        </p>
      </div>
    </section>

    <section>
      <h2>What people say</h2>
      {/* TODO: one testimonial quote with name and title */}
      <p>[TODO: one testimonial quote with name and title]</p>
    </section>

    <section>
      <p>
        If this sounds like your team, <a href={CALENDAR_URL}>book a 30-minute intro call</a> or <a
          href={EMAIL_URL}>send me an email</a
        >.
      </p>
    </section>
  </main>

  <SiteFooter />
</Layout>
