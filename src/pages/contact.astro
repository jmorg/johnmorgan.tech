---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CALENDAR_URL, EMAIL_ADDRESS, EMAIL_URL, GITHUB_URL, LINKEDIN_URL } from '../data/links';

// The TODO placeholders behind these links live in src/data/links.ts.
const links = [
  { label: 'Intro call', text: '[TODO: calendar link]', href: CALENDAR_URL, external: false },
  { label: 'Email', text: EMAIL_ADDRESS, href: EMAIL_URL, external: false },
  { label: 'LinkedIn', text: LINKEDIN_URL.replace('https://', ''), href: LINKEDIN_URL, external: true },
  { label: 'GitHub', text: GITHUB_URL.replace('https://', ''), href: GITHUB_URL, external: true },
];
---

<Layout title="Contact · John Morgan" description="How to get in touch with John Morgan.">
  <SiteHeader active="contact" />

  <main>
    <section>
      <span class="eyebrow">Contact</span>
      <h1>Get in touch</h1>
      <p class="lead">
        The best way to start is a 30-minute intro call. Or email me with a line about your team
        and what's going on.
      </p>
    </section>

    <section>
      <dl class="contact-list">
        {
          links.map((link) => (
            <div>
              <dt>{link.label}</dt>
              <dd>
                {link.external ? (
                  <a href={link.href} target="_blank" rel="noopener">
                    {link.text}
                  </a>
                ) : (
                  <a href={link.href}>{link.text}</a>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </main>

  <SiteFooter />
</Layout>
