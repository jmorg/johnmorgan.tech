---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection, render } from 'astro:content';

const projectsRaw = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const projects = await Promise.all(
  projectsRaw.map(async (project) => ({ ...project, ...(await render(project)) })),
);
---

<Layout
  title="Experience · John Morgan"
  description="Detailed work history and project write-ups for John Morgan."
>
  <SiteHeader active="experience" />

  <main>
    <section>
      <span class="eyebrow">Experience</span>
      <h1>Roles &amp; projects</h1>
      <p class="lead">
        The <a href="/">homepage</a> has the short version. This page has more detail on each role
        and a few projects.
      </p>
    </section>

    <section>
      <h2>Work &amp; education</h2>

      <div class="entry">
        <div class="entry-head">
          <h3>ManageXR · Head of Engineering</h3>
          <span class="entry-meta">Oct 2021 – May 2026</span>
        </div>
        <p>
          Joined as Lead Backend Engineer and became Head of Engineering, growing the team from 3
          people to 15. Worked with product and go-to-market teams to plan, architect, and deliver
          all engineering work, and wrote PRDs for new features.
        </p>
        <p>
          Built hiring, onboarding, and management practices from scratch. Owned relationships with
          key hardware and software partners and worked with Customer Success to triage, debug,
          prioritize, and fix customer issues. Joined enterprise sales cycles as both engineer and
          head of security, and helped close large deals.
        </p>
        <p>
          Set engineering standards by example as well as by management. I built major backend and
          Android systems and full-stack features myself.
        </p>
        <ul class="stack-list">
          <li>TypeScript</li>
          <li>Node.js</li>
          <li>Android</li>
          <li>Kotlin</li>
          <li>GCP</li>
        </ul>
      </div>

      <div class="entry">
        <div class="entry-head">
          <h3>Google · Senior Software Engineer, Tech Lead</h3>
          <span class="entry-meta">2017 – 2021</span>
        </div>
        <p>
          Led technical direction for a critical component of the Search Ranking backend. Reduced
          recall loss by more than 10% through large-scale ETL pipelines, feature engineering, and
          compression and performance work, and helped other teams run similar projects.
        </p>
        <p>
          Redesigned the deep neural network in the critical serving path, cutting tail search
          latency by 15ms. Became the team's go-to person for deep learning and ran an internal AI
          reading group. Built and maintained the testing infrastructure for a major infrastructure
          redesign, including coordinating on-call around it.
        </p>
        <p>
          Other work: ranking and retrieval for Google Maps Events that doubled CTR and DAU;
          machine learning ranking signals for local search quality on Search and Maps; and a 20%
          project with the TensorFlow Object Detection team using CNNs to identify tree species in
          major cities from satellite and street-level imagery.
        </p>
        <ul class="stack-list">
          <li>Machine Learning</li>
          <li>TensorFlow</li>
          <li>ETL</li>
          <li>C++</li>
        </ul>
      </div>

      <div class="entry">
        <div class="entry-head">
          <h3>Stanford University · B.S. Computer Science</h3>
          <span class="entry-meta">Class of 2017</span>
        </div>
        <p>
          Human-Computer Interaction track. 1st place, CS Department Software Fair 2017, for
          disaster response software. Stanford Debate Society member 2013–2017, captain 2014–2016.
        </p>
      </div>
    </section>

    <section>
      <h2>Projects</h2>
      {
        projects.map((project) => (
          <div class="entry">
            <div class="entry-head">
              <h3>{project.data.title}</h3>
              <span class="entry-meta">{project.data.period}</span>
            </div>
            <project.Content />
            <ul class="stack-list">
              {project.data.stack.map((tech: string) => (
                <li>{tech}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </main>

  <SiteFooter />
</Layout>
