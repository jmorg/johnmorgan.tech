---
interface Props {
  active?: 'home' | 'philosophy' | 'experience' | 'consulting' | 'contact';
}

const { active = 'home' } = Astro.props;

// The name is the page's h1 only on the homepage; other pages have their own h1.
const NameTag = active === 'home' ? 'h1' : 'p';
---

<header class="site-header">
  <div>
    <NameTag class="site-name"><a href="/">John Morgan</a></NameTag>
    <p class="role-line">Engineering leader · Fractional CTO</p>
  </div>
  <nav>
    <a href="/philosophy" aria-current={active === 'philosophy' ? 'page' : undefined}>Philosophy</a>
    <a href="/experience" aria-current={active === 'experience' ? 'page' : undefined}>Experience</a>
    <a href="/consulting" aria-current={active === 'consulting' ? 'page' : undefined}>Consulting</a>
    <a href="/contact" aria-current={active === 'contact' ? 'page' : undefined}>Contact</a>
  </nav>
</header>
